---
/**
 * The enquiry form in a page section, with what happens next beside it.
 * Anchored at #quote so the page's CTAs and the mobile sticky bar jump to it.
 */
import LeadForm from './LeadForm.astro';
import { company } from '../lib/data';
import { urls } from '../lib/urls';

interface Props {
  pageName: string;
  pest?: string;
  heading?: string;
}

const { pageName, pest, heading = 'Ask for a quote' } = Astro.props;
---

<section id="quote" class="border-t border-line bg-surface py-14 sm:py-20">
  <div class="wrap grid gap-12 lg:grid-cols-[1.5fr_1fr]">
    <div>
      <h2 class="text-2xl font-semibold sm:text-3xl">{heading}</h2>
      <p class="mt-3 max-w-xl text-ink-muted">
        Tell us the pest, the property and roughly where it is. It takes a minute, and
        there's no obligation to book.
      </p>
      <div class="mt-8">
        <LeadForm pageName={pageName} pest={pest} />
      </div>
    </div>

    <aside class="space-y-6 lg:pt-2">
      <div class="rounded-card border border-line bg-canvas p-6">
        <h3 class="font-semibold">What happens next</h3>
        <ol class="mt-4 space-y-3 text-sm leading-relaxed text-ink-muted">
          <li><strong class="font-semibold text-ink">1.</strong> We read your enquiry, usually within one working day.</li>
          <li><strong class="font-semibold text-ink">2.</strong> We pass it to a partner pest-control firm that handles this kind of job.</li>
          <li><strong class="font-semibold text-ink">3.</strong> The firm contacts you, inspects if needed, and gives you its price.</li>
          <li><strong class="font-semibold text-ink">4.</strong> You decide whether to go ahead.</li>
        </ol>
        <p class="mt-4 text-sm">
          <a href={urls.howItWorks()} class="text-brand underline underline-offset-2">More on how it works</a>
        </p>
      </div>
      <p class="text-sm leading-relaxed text-ink-muted">{company.operatingHoursDisplay}</p>
    </aside>
  </div>
</section>
